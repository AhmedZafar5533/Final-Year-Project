# Application and database
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/antigravity
JWT_SECRET=replace_with_a_long_random_secret

# Google OAuth; register this exact callback in your Google Cloud project.
YOUTUBE_CLIENT_ID=paste_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=paste_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/auth/callback
YOUTUBE_API_KEY=your_youtube_api_key

# DeepSeek powers sentiment, recommendations, scripts, and research.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash

# Web search: auto prefers a configured SearXNG instance, then optional Brave.
# Other modes: searxng, brave, none. Leave SEARXNG_URL empty if not running it.
WEB_SEARCH_PROVIDER=auto
SEARXNG_URL=http://127.0.0.1:8080
BRAVE_SEARCH_API_KEY=

# Internal services. Use the same random token in research_service/.env.
SENTIMENT_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_URL=http://127.0.0.1:8000
RESEARCH_SERVICE_URL=http://127.0.0.1:8001
RESEARCH_SERVICE_TOKEN=replace_with_the_same_random_token_in_both_services

# Research limits: 0 disables automatic jobs; range 0..10.
RESEARCH_AUTO_COUNT=3
# Per user per UTC day, range 1..100.
RESEARCH_DAILY_LIMIT=20
# Report freshness 1..168 hours; per-attempt deadline 30..600 seconds.
RESEARCH_FRESH_HOURS=24
RESEARCH_DEADLINE_SECONDS=300
# Research progress logs in backend/worker terminals; set to 0 to disable.
RESEARCH_LOGGING=1

# Optional Google aliases, used when corresponding YOUTUBE_* credentials are unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback
# Optional legacy Supabase integration (unused by current auth routes):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Optional isolated integration-test MongoDB server:
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
