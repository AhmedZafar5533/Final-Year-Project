# Copy to frontend/.env. No API credentials belong in this file.
# VITE_* values are exposed to the browser.

# Optional locally: leave blank to use Vite's /api proxy to localhost:5000.
# For a backend on a separate origin, set its full URL ending in /api:
# VITE_API_URL=https://your-backend.example.com/api
VITE_API_URL=
