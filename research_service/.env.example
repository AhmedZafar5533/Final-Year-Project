# Copy to research_service/.env.
# Start from research_service/ after installing requirements.txt:
# uvicorn main:app --env-file .env --host 127.0.0.1 --port 8001
# The --env-file option loads this file; no manual export is needed.

# Required: identical to RESEARCH_SERVICE_TOKEN in backend/.env.
# Generate your own random token once and paste it into both files.
RESEARCH_SERVICE_TOKEN=replace_with_the_same_random_token_in_both_services

# No DeepSeek, Brave, Google, Gemini, or local-model credentials are needed here.
# Express handles provider calls; this service only collects public pages.
