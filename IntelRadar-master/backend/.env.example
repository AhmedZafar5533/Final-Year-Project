# Copy to `.env` and fill in. The backend loads this file automatically.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key

# Optional: override the primary analysis model and its fallback chain.
# The chain is walked in order when a model is overloaded (503), rate-limited
# (429), or otherwise unavailable.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-2.5-pro

# Optional: the LLM-driven browser agent engine ("agent" scan mode).
# BROWSER_AGENT_MODEL=gemini-2.5-flash
# BROWSER_AGENT_MAX_STEPS=25
# BROWSER_AGENT_TIMEOUT=300

# Optional: live signals — recent news (Google News RSS) and YouTube comments.
# NEWS_MAX_ITEMS=8
# NEWS_LOOKBACK_DAYS=120
# NEWS_REGION=US
# NEWS_LANGUAGE=en-US
# COMMENTS_MAX=40

# Optional: continuous monitoring + change alerts (Apprise).
# MONITOR_ENABLED=true
# MONITOR_INTERVAL_MINUTES=360
# ALERT_URLS=discord://webhook_id/webhook_token,mailto://user:app_password@gmail.com

# Optional: comma-separated allowed CORS origins (default: *).
# CORS_ORIGINS=http://localhost:3000
